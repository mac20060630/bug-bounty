# ==============================================================================
# BugBounty MERN Platform - Global Environment Configuration
# ==============================================================================

# Backend Configuration
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb://mongodb:27017/bugbounty
JWT_SECRET=production_jwt_secret_key_minimum_32_characters_long!
JWT_EXPIRES_IN=7d
ADMIN_REGISTRATION_SECRET=production_admin_registration_secret_passphrase
CLIENT_URL=http://localhost:5173

# Cloudinary Configuration (Optional - Falls back to local disk storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend Configuration
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
