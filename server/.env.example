# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Provide a MongoDB connection string (e.g., mongodb://localhost:27017/bugbounty or Atlas URI).
# If unconfigured or unreachable in development, the server falls back to an in-memory database automatically.
MONGODB_URI=mongodb://127.0.0.1:27017/bugbounty

# Authentication / Security
JWT_SECRET=super_secure_jwt_secret_key_change_in_production_min_32_chars!
JWT_EXPIRES_IN=7d

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173
