# ==============================================================================
# BugBounty MERN Platform - Server Environment Configuration
# ==============================================================================

# Node Environment ('development', 'production', 'test')
NODE_ENV=production

# Server Listen Port
PORT=5000

# MongoDB Connection String (Atlas, standalone, or replica set)
# If unconfigured in development/test, an in-memory MongoDB instance will automatically spin up.
MONGODB_URI=mongodb://localhost:27017/bugbounty

# Authentication / JWT Configuration
# MUST be a cryptographically strong random string of at least 32 characters in production.
JWT_SECRET=replace_with_a_secure_random_32_character_string_for_production

# JWT Expiration Time (e.g. '7d', '24h', '1h')
JWT_EXPIRES_IN=7d

# Secret code required to register accounts with administrative privileges.
# Prevents unauthorized administrative privilege escalation during public registration.
ADMIN_REGISTRATION_SECRET=replace_with_secure_admin_registration_secret_passphrase

# Allowed Client Origin for CORS and WebSocket handshakes
CLIENT_URL=http://localhost:5173

# Cloudinary Cloud Storage Configuration (Optional)
# If left blank, evidence uploads will automatically fall back to local disk storage in server/uploads/evidence.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
